# Copy to .env and adjust for local development. Never commit real secrets.

# --- Database -------------------------------------------------------------
PHILFACILITIES_DB_PORT=54329
PHILFACILITIES_TEST_DB_PORT=54330
DATABASE_URL=postgresql+psycopg://philfacilities:philfacilities@localhost:54329/philfacilities
TEST_DATABASE_URL=postgresql+psycopg://philfacilities:philfacilities@localhost:54330/philfacilities_test

# --- API ------------------------------------------------------------------
PHILFACILITIES_ENV=local
PHILFACILITIES_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
PHILFACILITIES_RATE_LIMIT_PER_MINUTE=120
PHILFACILITIES_MAX_PAGE_SIZE=100
PHILFACILITIES_MAX_BBOX_AREA_DEG2=25

# --- Web ------------------------------------------------------------------
# Server-side API base used by Next.js server components.
API_BASE_URL=http://127.0.0.1:8010
# Browser-side API base used by the map client component. NEXT_PUBLIC_* values are
# inlined at build time, so set this before `pnpm build` in deployed environments.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8010
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# Basemap. Defaults are OpenStreetMap raster tiles with visible attribution for
# local development. Before launch, set both variables to a licensed tile
# provider (see docs/decisions/0006-basemap-provider.md). Set the attribution even
# if the provider does not require it; an unset attribution with a custom URL is a
# configuration error.
# NEXT_PUBLIC_MAP_TILE_URL=https://tiles.example.com/{z}/{x}/{y}.png
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=© Example Maps
# NEXT_PUBLIC_MAP_TILE_MAXZOOM=20

# --- Ingestion ------------------------------------------------------------
PHILFACILITIES_RAW_STORE=var/raw
PHILFACILITIES_REPORT_DIR=var/reports
# Optional webhook for actionable scheduled-check failures. Unset disables alerts.
# PHILFACILITIES_ALERT_WEBHOOK_URL=https://alerts.example.invalid/philfacilities
# Optional S3-compatible storage. Leave unset to use the filesystem adapter.
# PHILFACILITIES_S3_ENDPOINT=http://localhost:9000
# PHILFACILITIES_S3_BUCKET=philfacilities-raw
# PHILFACILITIES_S3_ACCESS_KEY=philfacilities
# PHILFACILITIES_S3_SECRET_KEY=philfacilities-local

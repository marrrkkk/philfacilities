{
  "name": "philfacilities",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @philfacilities/web dev",
    "build": "pnpm --filter @philfacilities/web build",
    "start": "pnpm --filter @philfacilities/web start",
    "lint": "pnpm --filter @philfacilities/web lint",
    "typecheck": "pnpm --filter @philfacilities/web typecheck",
    "test:e2e": "pnpm --filter @philfacilities/web test:e2e",
    "typegen": "pnpm --filter @philfacilities/api-client generate"
  }
}
